# --- Option 1 : Google AI Studio en direct (gratuit, sans carte bancaire) ---
# Clé gratuite : https://aistudio.google.com/apikey
# Dès qu'elle est remplie, l'agent l'utilise et ignore l'AI Gateway.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Option 2 : Vercel AI Gateway (nécessite des crédits achetés) ---
# Donne accès à Claude, meilleure qualité rédactionnelle.
# Attention : le palier gratuit du Gateway renvoie 403 sur les modèles Anthropic
# et 429 sur les modèles ouverts. Le plan Pro ne suffit pas, il faut un top-up.
AI_GATEWAY_API_KEY=

# Nombre de réseaux rédigés en parallèle (défaut : 2).
# Une campagne coûte 1 requête de brief + 1 par réseau. Le palier gratuit Google
# plafonne à 20 requêtes/minute : au-delà, les appels partent en 429 et l'AI SDK
# réessaie 3 fois chacun, ce qui sature la fenêtre encore plus vite.
# Sur une offre payante, monter à 6 pour diviser la latence par trois.
# CM_CONCURRENCY=2

# Surcharge du modèle (optionnel).
# Avec Google  : gemini-2.5-flash (défaut), gemini-2.5-pro
# Avec Gateway : anthropic/claude-sonnet-5 (défaut), anthropic/claude-opus-5
# CM_MODEL=
